; Export list for the logging pass-through.
;
; Thirteen names are implemented in ftd2xx_proxy.c so their traffic can be logged. Every
; other export is a **forwarder**: the Windows loader resolves it straight to the genuine
; driver, which must sit beside this DLL as ftd2xx_real.dll. No code here touches them, so
; there is no way to mangle a calling convention on a function nobody inspects.

LIBRARY FTD2XX
EXPORTS
    FT_Close
    FT_ClrDtr
    FT_ClrRts = ftd2xx_real.FT_ClrRts
    FT_CreateDeviceInfoList = ftd2xx_real.FT_CreateDeviceInfoList
    FT_CyclePort = ftd2xx_real.FT_CyclePort
    FT_EE_Program = ftd2xx_real.FT_EE_Program
    FT_EE_ProgramEx = ftd2xx_real.FT_EE_ProgramEx
    FT_EE_Read = ftd2xx_real.FT_EE_Read
    FT_EE_ReadEx = ftd2xx_real.FT_EE_ReadEx
    FT_EE_UARead = ftd2xx_real.FT_EE_UARead
    FT_EE_UASize = ftd2xx_real.FT_EE_UASize
    FT_EE_UAWrite = ftd2xx_real.FT_EE_UAWrite
    FT_EraseEE = ftd2xx_real.FT_EraseEE
    FT_GetBitMode = ftd2xx_real.FT_GetBitMode
    FT_GetDeviceInfo = ftd2xx_real.FT_GetDeviceInfo
    FT_GetDeviceInfoDetail = ftd2xx_real.FT_GetDeviceInfoDetail
    FT_GetDeviceInfoList = ftd2xx_real.FT_GetDeviceInfoList
    FT_GetEventStatus = ftd2xx_real.FT_GetEventStatus
    FT_GetLatencyTimer = ftd2xx_real.FT_GetLatencyTimer
    FT_GetModemStatus = ftd2xx_real.FT_GetModemStatus
    FT_GetQueueStatus
    FT_GetStatus = ftd2xx_real.FT_GetStatus
    FT_IoCtl = ftd2xx_real.FT_IoCtl
    FT_ListDevices
    FT_Open
    FT_OpenEx
    FT_Purge
    FT_Read
    FT_ReadEE = ftd2xx_real.FT_ReadEE
    FT_ResetDevice = ftd2xx_real.FT_ResetDevice
    FT_ResetPort = ftd2xx_real.FT_ResetPort
    FT_RestartInTask = ftd2xx_real.FT_RestartInTask
    FT_SetBaudRate
    FT_SetBitMode = ftd2xx_real.FT_SetBitMode
    FT_SetBreakOff = ftd2xx_real.FT_SetBreakOff
    FT_SetBreakOn = ftd2xx_real.FT_SetBreakOn
    FT_SetChars = ftd2xx_real.FT_SetChars
    FT_SetDataCharacteristics
    FT_SetDeadmanTimeout = ftd2xx_real.FT_SetDeadmanTimeout
    FT_SetDivisor = ftd2xx_real.FT_SetDivisor
    FT_SetDtr
    FT_SetEventNotification = ftd2xx_real.FT_SetEventNotification
    FT_SetFlowControl = ftd2xx_real.FT_SetFlowControl
    FT_SetLatencyTimer = ftd2xx_real.FT_SetLatencyTimer
    FT_SetResetPipeRetryCount = ftd2xx_real.FT_SetResetPipeRetryCount
    FT_SetRts = ftd2xx_real.FT_SetRts
    FT_SetTimeouts
    FT_SetUSBParameters = ftd2xx_real.FT_SetUSBParameters
    FT_SetWaitMask = ftd2xx_real.FT_SetWaitMask
    FT_StopInTask = ftd2xx_real.FT_StopInTask
    FT_W32_CancelIo = ftd2xx_real.FT_W32_CancelIo
    FT_W32_ClearCommBreak = ftd2xx_real.FT_W32_ClearCommBreak
    FT_W32_ClearCommError = ftd2xx_real.FT_W32_ClearCommError
    FT_W32_CloseHandle = ftd2xx_real.FT_W32_CloseHandle
    FT_W32_CreateFile = ftd2xx_real.FT_W32_CreateFile
    FT_W32_EscapeCommFunction = ftd2xx_real.FT_W32_EscapeCommFunction
    FT_W32_GetCommModemStatus = ftd2xx_real.FT_W32_GetCommModemStatus
    FT_W32_GetCommState = ftd2xx_real.FT_W32_GetCommState
    FT_W32_GetCommTimeouts = ftd2xx_real.FT_W32_GetCommTimeouts
    FT_W32_GetLastError = ftd2xx_real.FT_W32_GetLastError
    FT_W32_GetOverlappedResult = ftd2xx_real.FT_W32_GetOverlappedResult
    FT_W32_PurgeComm = ftd2xx_real.FT_W32_PurgeComm
    FT_W32_ReadFile = ftd2xx_real.FT_W32_ReadFile
    FT_W32_SetCommBreak = ftd2xx_real.FT_W32_SetCommBreak
    FT_W32_SetCommMask = ftd2xx_real.FT_W32_SetCommMask
    FT_W32_SetCommState = ftd2xx_real.FT_W32_SetCommState
    FT_W32_SetCommTimeouts = ftd2xx_real.FT_W32_SetCommTimeouts
    FT_W32_SetupComm = ftd2xx_real.FT_W32_SetupComm
    FT_W32_WaitCommEvent = ftd2xx_real.FT_W32_WaitCommEvent
    FT_W32_WriteFile = ftd2xx_real.FT_W32_WriteFile
    FT_WaitOnMask = ftd2xx_real.FT_WaitOnMask
    FT_Write
    FT_WriteEE = ftd2xx_real.FT_WriteEE
